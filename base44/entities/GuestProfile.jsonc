{
  "name": "GuestProfile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "title": "Username"
    },
    "username_key": {
      "type": "string",
      "title": "Username Key (lowercase)"
    },
    "wishlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Wishlist Product IDs"
    }
  },
  "required": [
    "username"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}