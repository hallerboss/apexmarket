{
  "name": "Page",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "excerpt": {
      "type": "string",
      "title": "Excerpt"
    },
    "featured_image": {
      "type": "string",
      "title": "Featured Image"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft"
      ],
      "title": "Status",
      "default": "published"
    },
    "show_in_menu": {
      "type": "boolean",
      "title": "Show in Menu",
      "default": false
    },
    "builder_mode": {
      "type": "boolean",
      "title": "Use Page Builder",
      "default": false
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "title": "Builder Blocks"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}