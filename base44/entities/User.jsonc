{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "wishlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Wishlist",
      "description": "Product IDs this customer has saved to their wishlist"
    },
    "photo": {
      "type": "string",
      "title": "Profile Photo",
      "description": "Profile picture URL used across the app, including customer reviews"
    }
  },
  "required": [
    "role"
  ]
}